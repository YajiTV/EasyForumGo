# Environment: dev or prod
APP_ENV=dev

# Server and reverse proxy
PORT=8080
HTTPS_PORT=8443
HOST_BIND=127.0.0.1
HOST_PORT=8080
HOST_HTTPS_PORT=8443
TLS_CERT_FILE=
TLS_KEY_FILE=
APP_BASE_PATH=
APP_PUBLIC_URL=http://localhost:8080
TRUST_PROXY=false

# SQLite database
DB_PATH=./data/forum.db
MIGRATIONS_DIR=./migrations

# Sessions
SESSION_DURATION_H=24

# Google OAuth
OAUTH_ID=
OAUTH_KEY=

# Static files and templates
STATIC_DIR=web/static
TEMPLATES_DIR=web/templates

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
